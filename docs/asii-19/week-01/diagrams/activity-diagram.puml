@startuml

title ASII-19 - Captura y corrección controlada de resultados pendientes

skinparam shadowing false

start

:Consultar resultados pendientes;

:Seleccionar resultado;

:Registrar resultado de laboratorio;

:Validar información ingresada;

if (¿Información correcta?) then (Sí)

:Guardar resultado;

:Publicar resultado;

:Resultado disponible para consulta;

stop

else (No)

:Corregir resultado;

:Validar nuevamente;

if (¿Corrección correcta?) then (Sí)

:Guardar resultado;

:Publicar resultado;

:Resultado disponible para consulta;

stop

else (No)

:Solicitar nueva corrección;

stop

endif

endif

@enduml

